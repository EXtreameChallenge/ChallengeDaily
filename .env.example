# ChallengeDaily 配置文件模板
# 复制此文件为 .env 并填入你的配置项
# cp .env.example .env

# AI 模型配置（兼容 OpenAI 接口协议）
# 默认使用智谱 GLM-4V-Flash（免费，支持视觉）用于识别截图
# GLM-4-Flash（免费，擅长文本）用于日报/文本分析
# 也可改为 DeepSeek、Qwen、Kimi 等兼容 OpenAI 协议的服务
# 请在应用内设置页面或首次引导页中输入你的 API Key
# API Key 将使用 Windows DPAPI 加密存储，不以明文保存在此文件
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_VISION_MODEL=glm-4v-flash
AI_TEXT_MODEL=glm-4-flash

# 截图间隔（秒），默认 60
# SCREENSHOT_INTERVAL_SEC=60

# 截图压缩质量（1-100），默认 70
# SCREENSHOT_QUALITY=70

# 截图最大宽度像素，超过则等比缩放，默认 1920
# SCREENSHOT_MAX_WIDTH=1920

# HTTP API 端口，默认 58888
# 支持两种环境变量名：PORT（优先）和 HTTP_PORT（兼容旧版）
# PORT=58888
# HTTP_PORT=58888

# 数据保留天数，默认 7
# RETENTION_DAYS=7

# 隐私关键词（逗号分隔），AI 分析时自动脱敏
# PRIVACY_KEYWORDS=
