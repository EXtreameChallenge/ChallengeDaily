{
  "manifest_version": 3,
  "name": "ChallengeDaily Web Tracker",
  "version": "1.0.0",
  "description": "追踪网页活动（URL/域名/标题/停留时长）并发送到 ChallengeDaily 后端。",
  "permissions": ["tabs", "activeTab", "storage", "idle", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:59300/*",
    "http://localhost:59300/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
