import { useState, useEffect, useMemo, useCallback } from 'react'
import { useNavigate } from 'react-router-dom'
import {
  ResponsiveContainer, Tooltip,
  LineChart, Line, XAxis, YAxis, CartesianGrid,
} from 'recharts'
import dayjs from 'dayjs'
import {
  getTodayStats,
  getStatus,
  getActivities,
  getTodayTodos,
  updateTodo,
  startPomodoro,
  getPomodoroSessions,
  getMorningInsights,
  pauseCollector,
  resumeCollector,
  getTrendStats,
  getRhythmStats,
  getAppIconUrl,
  getRecentHeatmap,
  CATEGORY_COLORS,
  type TodayStats,
  type CollectorStatus,
  type Activity,
  type Todo,
  type MorningInsight,
  type RecentHeatmapDay,
} from '../../api/client'
import TodayTimeline from './TodayTimeline'
import { useRelayEngine } from '../../components/relay/RelayEngine'
import HeroInfo from '../../components/HeroInfo'
import EmotionalCare from '../../components/EmotionalCare'
import SmartCoachPanel from '../../components/SmartCoachPanel'
import BenchmarkPanel from '../../components/BenchmarkPanel'
import MorningRitual from '../../components/MorningRitual'
import EveningRitual from '../../components/EveningRitual'
import DistractionHeatmap from '../../components/DistractionHeatmap'
import InfoTooltip, { METRIC_EXPLANATIONS } from '../../components/InfoTooltip'
import { useGrowthStore } from '../../stores/growthStore'
import {
  Play, Pause, Sun, Moon, Sunrise, Sunset, Coffee,
  TrendingUp, Clock, Zap, CheckCircle2, Sparkles,
  ChevronRight, Calendar, Target, Flame, ArrowRight,
  Trophy, Focus, CalendarDays, Activity as ActivityIcon,
} from 'lucide-react'

/** 卡片标题栏：标题在左，"更多" 在右 */
function CardHeader({ title, subtitle, linkTo, onNavigate }: {
  title: string
  subtitle?: string
  linkTo: string
  onNavigate: (path: string) => void
}) {
  return (
    <div className="flex items-center justify-between mb-3">
      <h3 className="text-sm font-semibold text-cd-text">
        {title}
        {subtitle && <span className="text-cd-text-tertiary font-normal ml-1.5">{subtitle}</span>}
      </h3>
      <button
        onClick={() => onNavigate(linkTo)}
        className="flex items-center gap-1 text-xs text-cd-text-tertiary hover:text-cd-green transition-colors group"
      >
        更多
        <ArrowRight size={12} className="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" />
      </button>
    </div>
  )
}

function getDisplayAppName(appName: string): string {
  const lower = appName.toLowerCase()
  const map: Record<string, string> = {
    'trae.exe': 'TRAE SOLO CN',
    'trae solo cn.exe': 'TRAE SOLO CN',
    'trae-solo-cn.exe': 'TRAE SOLO CN',
  }
  if (map[lower]) return map[lower]
  return appName.replace(/\.exe$/i, '')
}

const formatDur = (m: number) => m >= 60 ? `${(m / 60).toFixed(1)}h` : `${Math.round(m)}min`

const rhythmIcons: Record<string, string> = {
  '凌晨 (0-6)': '🌑', '早晨 (6-8)': '🌅', '上午 (8-11)': '🌞',
  '中午 (11-14)': '🍜', '下午 (14-19)': '☀️', '晚间 (19-22)': '🌆', '夜间 (22-24)': '🌙',
}
const rhythmShort: Record<string, string> = {
  '凌晨 (0-6)': '凌晨', '早晨 (6-8)': '早晨', '上午 (8-11)': '上午',
  '中午 (11-14)': '中午', '下午 (14-19)': '下午', '晚间 (19-22)': '晚间', '夜间 (22-24)': '夜间',
}

export default function TodayPage() {
  const navigate = useNavigate()
  const { triggerEvent } = useRelayEngine()

  // 核心数据
  const [stats, setStats] = useState<TodayStats | null>(null)
  const [status, setStatus] = useState<CollectorStatus | null>(null)
  const [activities, setActivities] = useState<Activity[]>([])
  const [todos, setTodos] = useState<Todo[]>([])
  const [morningInsights, setMorningInsights] = useState<MorningInsight[]>([])
  const [pomodoroSessions, setPomodoroSessions] = useState<any[]>([])

  // 丰富可视化数据
  const [heatmapData, setHeatmapData] = useState<RecentHeatmapDay[]>([])
  const [trendData, setTrendData] = useState<Array<{ date: string; count: number; category_count: number; duration_min: number }>>([])
  const [rhythmData, setRhythmData] = useState<Array<{ period: string; count: number; percentage: number; duration_min: number }>>([])
  const [peakPeriod, setPeakPeriod] = useState('')
  const [iconUrls, setIconUrls] = useState<Record<string, string>>({})

  // UI 状态
  const [loading, setLoading] = useState(true)
  const [refreshing, setRefreshing] = useState(false)
  const [activePomodoro, setActivePomodoro] = useState<{ taskTitle: string; startMin: number } | null>(null)

  const timeOfDay = getTimeOfDay()
  const greeting = getGreeting(timeOfDay)

  // 加载所有数据
  useEffect(() => {
    let isFirst = true
    const refresh = async () => {
      if (!isFirst) setRefreshing(true)
      useGrowthStore.getState().fetchGrowth()
      try {
        const [s, st, actsPage, td, ps] = await Promise.all([
          getTodayStats(),
          getStatus(),
          getActivities(undefined, 1, 8),
          getTodayTodos(),
          getPomodoroSessions(),
        ])
        setStats(s)
        setStatus(st)
        setActivities(actsPage.activities)
        setTodos(td.todos || [])
        setPomodoroSessions(ps.sessions || [])

        // 并行加载非关键数据
        Promise.allSettled([
          getRecentHeatmap(3).then(r => setHeatmapData(r.data)).catch(() => {}),
          getTrendStats(7).then(r => setTrendData(r.trend)).catch(() => {}),
          getRhythmStats().then(r => { setRhythmData(r.periods); setPeakPeriod(r.peak_period) }).catch(() => {}),
        ])
      } catch (err) {
        console.error('Failed to load today data:', err)
      } finally {
        setLoading(false)
        setRefreshing(false)
        isFirst = false
      }
    }
    refresh()
    const interval = setInterval(() => { if (!document.hidden) refresh() }, 60000)
    const onVisible = () => { if (!document.hidden) refresh() }
    document.addEventListener('visibilitychange', onVisible)
    return () => { clearInterval(interval); document.removeEventListener('visibilitychange', onVisible) }
  }, [])

  // 晨报
  useEffect(() => {
    if (timeOfDay === 'morning' || timeOfDay === 'forenoon') {
      getMorningInsights().then(res => setMorningInsights(res.insights || [])).catch(() => {})
      triggerEvent('morning_brief', { timeOfDay })
    }
    if (timeOfDay === 'afternoon') {
      const hour = dayjs().hour()
      if (hour >= 14 && hour < 16) triggerEvent('low_energy', { hour })
    }
  }, [timeOfDay, triggerEvent])

  // 应用图标
  const topAppsKey = useMemo(() => stats?.top_apps?.map(a => a.app_name).join('|'), [stats?.top_apps])
  useEffect(() => {
    if (!stats?.top_apps?.length) return
    let cancelled = false
    ;(async () => {
      const map: Record<string, string> = {}
      await Promise.all(stats.top_apps!.map(async (app) => {
        try {
          const iconKey = app.app_name_raw || app.app_name
          map[app.app_name] = await getAppIconUrl(iconKey)
        } catch { map[app.app_name] = '' }
      }))
      if (!cancelled) setIconUrls(map)
    })()
    return () => { cancelled = true }
  }, [topAppsKey])

  // 计算值
  const totalMin = stats?.total_duration_min || 0
  const hours = Math.floor(totalMin / 60)
  const mins = Math.round(totalMin % 60)
  const timeStr = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`
  const captureCount = status?.total_captures || 0
  const focusSessions = stats?.focus_sessions || 0
  const longestFocus = stats?.longest_focus_min || 0
  const isRecording = status?.running && !status?.paused
  const isPaused = status !== null && !status.running
  const intervalSec = status?.interval_sec || 60
  const topApps = stats?.top_apps || []

  const categoryBars = stats?.categories
    ? Object.entries(stats.categories).map(([name, value]) => ({ name, value: Math.round(value) })).filter(d => d.value > 0).sort((a, b) => b.value - a.value)
    : []
  const totalCategoryMin = categoryBars.reduce((s, d) => s + d.value, 0)
  const topCategory = categoryBars[0]?.name || '-'

  const heatmapBins = heatmapData.map(day => {
    const cells: number[] = []
    for (let b = 0; b < 12; b++) cells.push((day.hours[2 * b] || 0) + (day.hours[2 * b + 1] || 0))
    return { ...day, cells }
  })
  const maxHeatVal = Math.max(...heatmapBins.flatMap(d => d.cells), 1)
  const validTrend = trendData.filter(d => d.duration_min > 0)
  const recentActivities = activities.slice(0, 8)
  const isEmptyState = !stats?.total_duration_min && activities.length === 0

  // 今日评分
  const todayScore = useMemo(() => {
    if (!stats) return 0
    const timeScore = Math.min(totalMin / 480, 1) * 40
    const pomoScore = Math.min((pomodoroSessions.length || focusSessions) / 8, 1) * 20
    const completed = todos.filter(t => t.status === 'completed').length
    const todoScore = todos.length > 0 ? (completed / todos.length) * 25 : 12
    return Math.round(timeScore + pomoScore + todoScore + 15)
  }, [stats, totalMin, pomodoroSessions, focusSessions, todos])

  // 操作
  const handleResume = async () => { try { await resumeCollector(); const s = await getStatus(); setStatus(s) } catch (e) { console.error(e) } }
  const handlePause = async () => { try { await pauseCollector(); const s = await getStatus(); setStatus(s) } catch (e) { console.error(e) } }

  const handleCompleteTodo = useCallback(async (todo: Todo) => {
    try {
      await updateTodo(todo.id, { status: 'completed' })
      setTodos(prev => prev.map(t => t.id === todo.id ? { ...t, status: 'completed' } : t))
      const nextTodo = todos.find(t => t.id !== todo.id && t.status !== 'completed')
      triggerEvent('todo_completed', { todoId: todo.id, todoTitle: todo.title, nextTodoId: nextTodo?.id, nextTodoTitle: nextTodo?.title, nextTodo: !!nextTodo })
    } catch (err) { console.error('Failed to complete todo:', err) }
  }, [todos, triggerEvent])

  const handleStartPomodoro = useCallback(async (todo?: Todo) => {
    try {
      await startPomodoro({ task_title: todo?.title || '专注工作', duration_min: 25 })
      setActivePomodoro({ taskTitle: todo?.title || '专注工作', startMin: dayjs().hour() * 60 + dayjs().minute() })
    } catch (err) { console.error('Failed to start pomodoro:', err) }
  }, [])

  const handleEndPomodoro = useCallback(() => {
    setActivePomodoro(null)
    triggerEvent('pomodoro_completed', { durationMin: 25, taskTitle: activePomodoro?.taskTitle })
  }, [activePomodoro, triggerEvent])

  if (loading) {
    return <div className="animate-pulse text-cd-text-tertiary text-base p-6">加载中...</div>
  }

  if (isEmptyState) {
    return (
      <div className="animate-fade-in flex items-center justify-center h-full">
        <div className="text-center max-w-md">
          <div className="w-20 h-20 rounded-2xl bg-cd-green/10 flex items-center justify-center mx-auto mb-5">
            <ActivityIcon size={40} className="text-cd-green" />
          </div>
          <h2 className="text-xl font-semibold text-cd-text mb-3 font-display">欢迎使用 <span className="font-brand font-bold">ChallengeDaily</span></h2>
          {isPaused ? (
            <>
              <p className="text-base text-cd-text-secondary mb-6">采集器已暂停，点击开始自动记录。</p>
              <button onClick={handleResume} className="inline-flex items-center gap-2 bg-cd-green text-white px-7 py-3 rounded-lg text-base font-medium hover:opacity-90 transition">
                <Play size={18} /> 开始记录
              </button>
            </>
          ) : (
            <p className="text-base text-cd-text-secondary">正在自动记录你的活动，稍等片刻即可看到数据。</p>
          )}
        </div>
      </div>
    )
  }

  return (
    <div className="animate-fade-in pb-4">
      {/* ─── 晨间规划 ──── */}
      {(timeOfDay === 'morning' || timeOfDay === 'forenoon') && (
        <div className="mb-4"><MorningRitual /></div>
      )}

      {/* ─── Hero 区域 ──── */}
      <div className="mb-5">
        <div className="flex items-start justify-between gap-4">
          <div className="flex-1 min-w-0">
            <HeroInfo todayDurationMin={totalMin} />
          </div>
          <button
            onClick={isRecording ? handlePause : handleResume}
            className={`shrink-0 flex items-center gap-2 text-sm px-4 py-2 rounded-lg transition border ${
              isRecording ? 'border-cd-green/20 bg-cd-green/5 text-cd-green' : 'border-cd-red/20 bg-cd-red/5 text-cd-red'
            }`}
          >
            {isRecording ? <><span className="w-2 h-2 rounded-full bg-cd-green animate-pulse-soft" /> 正在记录</> : <><span className="w-2 h-2 rounded-full bg-cd-red" /> 已暂停</>}
          </button>
        </div>

        {/* 三个核心指标 */}
        <div className="grid grid-cols-4 gap-4 mt-4">
          <div>
            <p className="text-xs text-cd-text-tertiary uppercase tracking-widest mb-1 flex items-center gap-1">
              专注时长 <InfoTooltip {...METRIC_EXPLANATIONS.focus_min} />
            </p>
            <p className="text-3xl font-bold text-cd-text font-brand tracking-tight">{timeStr}</p>
            <p className="text-xs text-cd-text-tertiary mt-0.5"><span className="font-brand font-semibold">{captureCount}</span> 次活动捕捉</p>
          </div>
          <div>
            <p className="text-xs text-cd-text-tertiary uppercase tracking-widest mb-1 flex items-center gap-1">
              深度工作 <InfoTooltip {...METRIC_EXPLANATIONS.deep_work_hours} />
            </p>
            <p className="text-3xl font-bold text-cd-text font-brand tracking-tight">{focusSessions} <span className="text-lg font-normal text-cd-text-tertiary">次</span></p>
            <p className="text-xs text-cd-text-tertiary mt-0.5">{longestFocus > 0 ? `最长 ${formatDur(longestFocus)}` : '今日暂无'}</p>
          </div>
          <div>
            <p className="text-xs text-cd-text-tertiary uppercase tracking-widest mb-1">高效时段</p>
            <p className="text-3xl font-bold text-cd-text font-display tracking-tight">{peakPeriod ? rhythmShort[peakPeriod] || peakPeriod.split(' ')[0] : '-'}</p>
            <p className="text-xs text-cd-text-tertiary mt-0.5">主要分类 · {topCategory}</p>
          </div>
          <div>
            <p className="text-xs text-cd-text-tertiary uppercase tracking-widest mb-1">今日评分</p>
            <p className="text-3xl font-bold font-brand tracking-tight" style={{ color: todayScore >= 70 ? 'var(--cd-green)' : todayScore >= 40 ? 'var(--cd-yellow)' : 'var(--cd-red)' }}>{todayScore}<span className="text-lg font-normal text-cd-text-tertiary">/100</span></p>
            <p className="text-xs text-cd-text-tertiary mt-0.5">{todos.filter(t => t.status === 'completed').length}/{todos.length} 待办完成</p>
          </div>
        </div>

        {/* 快捷入口 */}
        <div className="flex items-center gap-3 mt-3 flex-wrap">
          <a href="#/dashboard" className="text-sm text-cd-green hover:underline flex items-center gap-1"><TrendingUp size={14} /> 完整进度仪表盘</a>
          <span className="text-cd-text-tertiary">·</span>
          <a href="#/week-plan" className="text-sm text-cd-green hover:underline flex items-center gap-1"><CalendarDays size={14} /> 周计划</a>
          <span className="text-cd-text-tertiary">·</span>
          <a href="#/focus" className="text-sm text-cd-green hover:underline flex items-center gap-1"><Focus size={14} /> 开始专注</a>
          <span className="text-cd-text-tertiary">·</span>
          <a href="#/todos" className="text-sm text-cd-green hover:underline flex items-center gap-1"><Target size={14} /> 待办清单</a>
        </div>

        {/* 情感关怀 + 智能教练 */}
        <div className="mt-3"><EmotionalCare /></div>
        <div className="mt-3"><SmartCoachPanel /></div>

        {/* 行业基准 */}
        <div className="mt-3 bg-cd-card border border-cd-border rounded-xl p-4">
          <div className="flex items-center gap-2 mb-3">
            <Trophy size={14} className="text-cd-green" />
            <h3 className="text-sm font-semibold text-cd-text">行业基准对比</h3>
            <span className="text-xs text-cd-text-tertiary ml-1">看看你在同业中的位置</span>
          </div>
          <BenchmarkPanel />
        </div>
      </div>

      {/* ─── 分隔线 ──── */}
      <div className="border-t border-cd-border mb-4" />

      {/* ─── 主区域：左 时间线+待办+番茄 | 右 可视化 ──── */}
      <div className="grid grid-cols-5 gap-4">
        {/* 左列：时间线 + 待办 + 番茄钟（占3列） */}
        <div className="col-span-3 space-y-4">
          {/* 番茄钟状态卡 */}
          {activePomodoro ? (
            <div className="bg-cd-card border border-cd-green/30 rounded-xl p-4">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-full bg-cd-green/10 flex items-center justify-center">
                    <Flame size={20} className="text-cd-green animate-pulse" />
                  </div>
                  <div>
                    <p className="text-sm font-semibold text-cd-text">{activePomodoro.taskTitle}</p>
                    <p className="text-xs text-cd-text-tertiary">专注中 · 25分钟</p>
                  </div>
                </div>
                <button onClick={handleEndPomodoro} className="px-4 py-2 rounded-lg text-sm bg-cd-red/10 text-cd-red hover:bg-cd-red/20 transition">
                  结束专注
                </button>
              </div>
            </div>
          ) : (
            <div className="bg-cd-card border border-cd-border rounded-xl p-4">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-full bg-cd-purple/10 flex items-center justify-center">
                    <Zap size={20} className="text-cd-purple" />
                  </div>
                  <div>
                    <p className="text-sm font-semibold text-cd-text">快速开始专注</p>
                    <p className="text-xs text-cd-text-tertiary">25分钟番茄钟 · 今日已完成 {pomodoroSessions.length || focusSessions} 个</p>
                  </div>
                </div>
                <button onClick={() => handleStartPomodoro()} className="px-4 py-2 rounded-lg text-sm bg-cd-green text-white hover:opacity-90 transition flex items-center gap-1.5">
                  <Play size={14} /> 开始专注
                </button>
              </div>
            </div>
          )}

          {/* 今日时间线（核心） */}
          <div>
            <CardHeader title="今日时间线" linkTo="/timeline" onNavigate={navigate} />
            <TodayTimeline activities={activities} todos={todos} onStartPomodoro={handleStartPomodoro} onCompleteTodo={handleCompleteTodo} />
          </div>

          {/* 待办清单 */}
          {todos.length > 0 && (
            <div>
              <CardHeader title="今日待办" subtitle={`${todos.filter(t => t.status === 'completed').length}/${todos.length}`} linkTo="/todos" onNavigate={navigate} />
              <div className="bg-cd-card border border-cd-border rounded-xl p-4 space-y-2.5">
                {todos.slice(0, 6).map(todo => (
                  <div key={todo.id} className="flex items-center gap-3 group">
                    <button
                      onClick={() => handleCompleteTodo(todo)}
                      className={`w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition ${
                        todo.status === 'completed' ? 'bg-cd-green border-cd-green' : 'border-cd-border hover:border-cd-green'
                      }`}
                    >
                      {todo.status === 'completed' && <CheckCircle2 size={12} className="text-white" />}
                    </button>
                    <span className={`flex-1 text-sm ${todo.status === 'completed' ? 'text-cd-text-tertiary line-through' : 'text-cd-text'}`}>{todo.title}</span>
                    {todo.status !== 'completed' && (
                      <button onClick={() => handleStartPomodoro(todo)} className="opacity-0 group-hover:opacity-100 text-xs text-cd-green hover:underline transition flex items-center gap-1">
                        <Play size={10} /> 专注
                      </button>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* 晨报洞察（早晨） */}
          {(timeOfDay === 'morning' || timeOfDay === 'forenoon') && morningInsights.length > 0 && (
            <div>
              <CardHeader title="AI 晨报洞察" linkTo="/report" onNavigate={navigate} />
              <div className="bg-cd-card border border-cd-border rounded-xl p-4 space-y-3">
                {morningInsights.slice(0, 3).map((insight, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <Sparkles size={16} className="text-cd-purple mt-0.5 shrink-0" />
                    <p className="text-sm text-cd-text-secondary leading-relaxed">{insight.content || insight.insight || String(insight)}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* 右列：可视化面板（占2列） */}
        <div className="col-span-2 space-y-4">
          {/* 时间分布 */}
          <div>
            <CardHeader title="时间都去哪了" linkTo="/timeline" onNavigate={navigate} />
            <div className="bg-cd-card border border-cd-border rounded-xl p-4">
              {categoryBars.length > 0 ? (
                <div className="space-y-4">
                  {categoryBars.slice(0, 5).map(entry => {
                    const pct = totalCategoryMin > 0 ? Math.round(entry.value / totalCategoryMin * 100) : 0
                    const color = CATEGORY_COLORS[entry.name] || 'var(--cd-text-tertiary)'
                    return (
                      <div key={entry.name}>
                        <div className="flex items-center justify-between mb-2">
                          <div className="flex items-center gap-2.5 min-w-0">
                            <div className="w-2.5 h-2.5 rounded-full shrink-0" style={{ background: color }} />
                            <span className="text-sm text-cd-text truncate">{entry.name}</span>
                          </div>
                          <span className="text-sm text-cd-text-tertiary shrink-0 ml-3">
                            <span className="font-brand font-semibold text-cd-text">{formatDur(entry.value)}</span>
                            <span className="text-xs ml-1 font-brand">{pct}%</span>
                          </span>
                        </div>
                        <div className="h-2 rounded-full bg-cd-bg-secondary overflow-hidden">
                          <div className="h-full rounded-full transition-all duration-500" style={{ width: `${Math.max(pct, 2)}%`, background: color }} />
                        </div>
                      </div>
                    )
                  })}
                </div>
              ) : <p className="text-sm text-cd-text-tertiary text-center py-4">暂无分类数据</p>}
            </div>
          </div>

          {/* 近三天热力图 */}
          <div>
            <CardHeader title="近三天热力图" linkTo="/heatmap" onNavigate={navigate} />
            <div className="bg-cd-card border border-cd-border rounded-xl p-4">
              <div className="grid grid-cols-12 gap-1 pl-[52px] mb-1.5">
                {Array.from({ length: 12 }, (_, b) => (
                  <div key={b} className="text-center text-[9px] text-cd-text-tertiary font-brand">{b * 2}</div>
                ))}
              </div>
              {[...heatmapBins].reverse().map((day, di) => {
                const dayLabel = di === 0 ? 'Today' : di === 1 ? 'Yesterday' : dayjs(day.date).format('MM/DD')
                return (
                  <div key={day.date} className="mb-2">
                    <div className="flex items-center gap-1">
                      <span className="text-[10px] text-cd-text-tertiary w-11 text-right shrink-0 mr-1 font-brand">{dayLabel}</span>
                      <div className="flex-1 grid grid-cols-12 gap-1">
                        {day.cells.map((val, b) => {
                          const intensity = maxHeatVal > 0 ? val / maxHeatVal : 0
                          const cellMin = Math.round(val * intervalSec / 60)
                          return (
                            <div key={b} className="h-4 rounded-sm transition-all hover:scale-110 cursor-default"
                              style={{ background: val === 0 ? 'var(--cd-bg-tertiary)' : `rgba(99,91,255,${0.1 + intensity * 0.7})` }}
                              title={`${dayjs(day.date).format('MM/DD')} ${b * 2}:00-${b * 2 + 2}:00 · ${cellMin}分钟 · ${val}次活动`} />
                          )
                        })}
                      </div>
                    </div>
                    <div className="pl-[52px] mt-1 flex items-center gap-2 text-[10px] text-cd-text-tertiary">
                      <span>总 <span className="text-cd-text font-brand font-semibold">{formatDur(day.total_min)}</span></span>
                      <span>·</span>
                      <span>峰值 <span className="text-cd-text font-brand font-semibold">{day.peak_hour >= 0 ? `${day.peak_hour}:00` : '-'}</span></span>
                    </div>
                  </div>
                )
              })}
              <div className="flex items-center gap-1 mt-1 pl-[52px]">
                <span className="text-[10px] text-cd-text-tertiary">Less</span>
                {[0, 0.25, 0.5, 0.75, 1].map((v, i) => (
                  <div key={i} className="w-3.5 h-3 rounded-sm" style={{ background: v === 0 ? 'var(--cd-bg-tertiary)' : `rgba(99,91,255,${0.1 + v * 0.7})` }} />
                ))}
                <span className="text-[10px] text-cd-text-tertiary">More</span>
              </div>
            </div>
          </div>

          {/* 应用使用 Top5 */}
          <div>
            <CardHeader title="应用使用" linkTo="/apps" onNavigate={navigate} />
            <div className="bg-cd-card border border-cd-border rounded-xl p-4">
              {topApps.length > 0 ? (
                <div className="space-y-2.5">
                  {topApps.slice(0, 5).map(app => {
                    const pct = totalMin > 0 ? (app.duration_min / totalMin) * 100 : 0
                    const iconUrl = iconUrls[app.app_name]
                    const defaultIcon = import.meta.env.DEV ? '/icon.png' : './icon.png'
                    return (
                      <div key={app.app_name} className="flex items-center gap-2.5">
                        <div className="w-7 h-7 rounded-md bg-cd-bg-secondary border border-cd-border-light flex items-center justify-center shrink-0 overflow-hidden">
                          <img src={iconUrl || defaultIcon} alt="" className="w-5 h-5 object-contain" onError={(e) => { e.currentTarget.src = defaultIcon }} />
                        </div>
                        <div className="flex-1 min-w-0">
                          <div className="flex items-center justify-between mb-0.5">
                            <span className="text-xs text-cd-text truncate">{getDisplayAppName(app.app_name)}</span>
                            <span className="text-xs font-brand font-semibold text-cd-text shrink-0 ml-2">{formatDur(app.duration_min)}</span>
                          </div>
                          <div className="h-1.5 rounded-full bg-cd-bg-secondary overflow-hidden">
                            <div className="h-full rounded-full bg-cd-green/60 transition-all duration-500" style={{ width: `${Math.max(pct, 2)}%` }} />
                          </div>
                        </div>
                      </div>
                    )
                  })}
                </div>
              ) : <p className="text-sm text-cd-text-tertiary text-center py-4">暂无应用记录</p>}
            </div>
          </div>

          {/* 效率趋势 7天 */}
          <div>
            <CardHeader title="效率趋势" subtitle="7d" linkTo="/timeline" onNavigate={navigate} />
            <div className="bg-cd-card border border-cd-border rounded-xl p-4 min-h-[160px]">
              {validTrend.length > 0 ? (
                <div className="h-[130px]">
                  <ResponsiveContainer width="100%" height="100%">
                    <LineChart data={trendData} margin={{ top: 8, right: 8, left: -16, bottom: 0 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke="var(--cd-border)" vertical={false} />
                      <XAxis dataKey="date" tickFormatter={(v: string) => dayjs(v).format('M/D')}
                        tick={{ fontSize: 11, fill: 'var(--cd-text-tertiary)' }} axisLine={{ stroke: 'var(--cd-border)' }} tickLine={false} />
                      <YAxis tick={{ fontSize: 11, fill: 'var(--cd-text-tertiary)' }} axisLine={false} tickLine={false}
                        tickFormatter={(v: number) => `${Math.round(v / 60 * 10) / 10}h`} width={36} />
                      <Tooltip formatter={(value: number) => [value >= 60 ? `${(value / 60).toFixed(1)}h` : `${Math.round(value)}min`, '时长']}
                        labelFormatter={(label: string) => dayjs(label).format('YYYY-MM-DD')}
                        contentStyle={{ background: 'var(--cd-card)', border: '1px solid var(--cd-border)', borderRadius: 8, fontSize: 12 }} />
                      <Line type="monotone" dataKey="duration_min" stroke="var(--cd-green)" strokeWidth={2}
                        dot={{ r: 3, fill: 'var(--cd-green)' }} activeDot={{ r: 5 }} />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              ) : <div className="h-[130px] flex items-center justify-center"><p className="text-sm text-cd-text-tertiary">数据积累中</p></div>}
            </div>
          </div>

          {/* 个人节奏 */}
          <div>
            <CardHeader title="个人节奏" linkTo="/heatmap" onNavigate={navigate} />
            <div className="bg-cd-card border border-cd-border rounded-xl p-4">
              {rhythmData.length > 0 ? (
                <div className="space-y-3">
                  {rhythmData.map(item => {
                    const maxHours: Record<string, number> = { '凌晨 (0-6)': 6, '早晨 (6-8)': 2, '上午 (8-11)': 3, '中午 (11-14)': 3, '下午 (14-19)': 5, '晚间 (19-22)': 3, '夜间 (22-24)': 2 }
                    const maxMin = (maxHours[item.period] || 2) * 60
                    const ratio = Math.min(item.duration_min / maxMin, 1)
                    return (
                      <div key={item.period}>
                        <div className="flex items-center justify-between mb-1.5">
                          <span className="text-sm text-cd-text flex items-center gap-2">{rhythmIcons[item.period] || '⏰'} {rhythmShort[item.period] || item.period}</span>
                          <span className="text-sm font-brand font-semibold text-cd-text">{item.duration_min >= 60 ? `${(item.duration_min / 60).toFixed(1)}h` : `${Math.round(item.duration_min)}m`}</span>
                        </div>
                        <div className="h-1.5 rounded-full bg-cd-bg-secondary overflow-hidden">
                          <div className="h-full rounded-full bg-cd-purple transition-all duration-500" style={{ width: `${Math.max(ratio * 100, 2)}%`, opacity: 0.4 + ratio * 0.6 }} />
                        </div>
                      </div>
                    )
                  })}
                </div>
              ) : <p className="text-sm text-cd-text-tertiary text-center py-4">暂无数据</p>}
            </div>
          </div>
        </div>
      </div>

      {/* ─── 分心热点图 ──── */}
      <div className="mt-4"><DistractionHeatmap /></div>

      {/* ─── 最近活动 ──── */}
      {recentActivities.length > 0 && (
        <div className="mt-4 pt-4 border-t border-cd-border">
          <CardHeader title="最近活动" linkTo="/timeline" onNavigate={navigate} />
          <div className="flex gap-2.5 overflow-x-auto pb-1">
            {recentActivities.map(act => {
              const color = CATEGORY_COLORS[act.category] || 'var(--cd-text-tertiary)'
              return (
                <div key={act.id} className="shrink-0 bg-cd-bg-secondary/50 border border-cd-border/50 rounded-lg px-3.5 py-2.5 min-w-0 max-w-[200px] cursor-default hover:bg-cd-hover transition">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-[11px] font-mono text-cd-text-tertiary">{dayjs(act.timestamp).format('HH:mm')}</span>
                    <span className="w-1.5 h-1.5 rounded-full shrink-0" style={{ background: color }} />
                    <span className="text-xs font-medium truncate" style={{ color }}>{act.category}</span>
                  </div>
                  <div className="text-[13px] text-cd-text truncate">{act.ai_summary || act.app_name}</div>
                </div>
              )
            })}
          </div>
        </div>
      )}

      {/* ─── 晚间回顾 ──── */}
      {(timeOfDay === 'evening' || timeOfDay === 'night') && (
        <div className="mt-4"><EveningRitual /></div>
      )}
    </div>
  )
}

function getTimeOfDay(): 'morning' | 'forenoon' | 'noon' | 'afternoon' | 'evening' | 'night' {
  const h = dayjs().hour()
  if (h >= 6 && h < 9) return 'morning'
  if (h >= 9 && h < 12) return 'forenoon'
  if (h >= 12 && h < 14) return 'noon'
  if (h >= 14 && h < 18) return 'afternoon'
  if (h >= 18 && h < 22) return 'evening'
  return 'night'
}

function getGreeting(t: string): string {
  const map: Record<string, string> = {
    morning: '早上好', forenoon: '上午好', noon: '中午好',
    afternoon: '下午好', evening: '晚上好', night: '夜深了',
  }
  return map[t] || '你好'
}
